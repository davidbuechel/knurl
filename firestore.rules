rules_version = '2';

// Knurl: every document belongs to exactly one user and lives under users/{uid}.
// Nobody reads or writes anyone else's data. Shapes are checked so a bug can't
// fill the database with junk; deep contents (sets inside exercises) are the
// app's job. Tests: firestore-tests/*.test.mjs.

service cloud.firestore {
  match /databases/{database}/documents {

    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function data() {
      return request.resource.data;
    }

    function stampedNow() {
      return data().updatedAt == request.time;
    }

    function text(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function validProfile() {
      return data().keys().hasOnly(['settings', 'schemaVersion', 'createdAt'])
        && data().settings is map
        && (!('schemaVersion' in data()) || data().schemaVersion is int);
    }

    function validWorkout(id) {
      return data().keys().hasOnly(['id', 'name', 'routineId', 'startedAtMs', 'endedAtMs', 'exercises', 'note', 'updatedAt'])
        && data().id == id
        && text(data().name, 1, 100)
        && data().startedAtMs is int
        && (data().endedAtMs == null || data().endedAtMs is int)
        && (data().routineId == null || data().routineId is string)
        && data().exercises is list && data().exercises.size() <= 60
        && (!('note' in data()) || text(data().note, 0, 2000))
        && stampedNow();
    }

    function validBodyWeight(id) {
      return data().keys().hasOnly(['id', 'atMs', 'weightKg', 'updatedAt'])
        && data().id == id
        && data().atMs is int
        && data().weightKg is number && data().weightKg > 0 && data().weightKg < 500
        && stampedNow();
    }

    function validRoutine(id) {
      return data().keys().hasOnly(['id', 'name', 'items', 'position', 'updatedAt'])
        && data().id == id
        && text(data().name, 1, 80)
        && data().items is list && data().items.size() <= 60
        && data().position is int
        && stampedNow();
    }

    // Every field of the app's Exercise model is written (defaults included). Own exercises carry
    // no instructions or hosted photos; their photo lives in exercisePhotos.
    function validCustomExercise(id) {
      return data().keys().hasOnly(['id', 'nameDe', 'nameEn', 'primary', 'secondary', 'equipment', 'pattern', 'isCustom',
                                    'level', 'instructionsEn', 'instructionsDe', 'images', 'note', 'archived', 'updatedAt'])
        && data().id == id
        && text(data().nameDe, 1, 80) && text(data().nameEn, 1, 80)
        && data().primary is string && data().equipment is string && data().pattern is string
        && (!('secondary' in data()) || (data().secondary is list && data().secondary.size() <= 3))
        && (!('note' in data()) || text(data().note, 0, 500))
        && (!('archived' in data()) || data().archived is bool)
        && (!('instructionsEn' in data()) || (data().instructionsEn is list && data().instructionsEn.size() == 0))
        && (!('instructionsDe' in data()) || (data().instructionsDe is list && data().instructionsDe.size() == 0))
        && (!('images' in data()) || data().images == 0)
        && data().isCustom == true
        && stampedNow();
    }

    // A small WebP of an own exercise (480 px, base64 about 50 KB; the cap leaves room). Only for an
    // exercise that exists.
    function validExercisePhoto(uid, id) {
      return data().keys().hasOnly(['webp', 'updatedAt'])
        && text(data().webp, 1, 200000)
        && exists(/databases/$(database)/documents/users/$(uid)/customExercises/$(id))
        && stampedNow();
    }

    function optionalNumber(field, max) {
      return !(field in data()) || data()[field] == null || (data()[field] is number && data()[field] >= 0 && data()[field] <= max);
    }

    // One thing eaten on a day (ISO date). Quick entries have no grams or food.
    function validFoodEntry(id) {
      return data().keys().hasOnly(['id', 'day', 'atMs', 'name', 'kcal', 'proteinG', 'carbsG', 'fatG', 'grams', 'foodId', 'updatedAt'])
        && data().id == id
        && data().day is string && data().day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && data().atMs is int
        && text(data().name, 1, 160)
        && data().kcal is int && data().kcal >= 0 && data().kcal <= 20000
        && data().proteinG is number && data().proteinG >= 0 && data().proteinG <= 2000
        && optionalNumber('carbsG', 5000) && optionalNumber('fatG', 2000) && optionalNumber('grams', 10000)
        && (!('foodId' in data()) || data().foodId == null || text(data().foodId, 1, 100))
        && stampedNow();
    }

    // A food used before, values per 100 g.
    function validFood(id) {
      return data().keys().hasOnly(['id', 'name', 'brand', 'barcode', 'kcalPer100', 'proteinPer100', 'carbsPer100', 'fatPer100',
                                    'servingG', 'lastUsedMs', 'updatedAt'])
        && data().id == id
        && text(data().name, 1, 120)
        && (!('brand' in data()) || text(data().brand, 0, 120))
        && (!('barcode' in data()) || data().barcode == null || text(data().barcode, 1, 32))
        && data().kcalPer100 is number && data().kcalPer100 >= 0 && data().kcalPer100 <= 1000
        && data().proteinPer100 is number && data().proteinPer100 >= 0 && data().proteinPer100 <= 100
        && optionalNumber('carbsPer100', 100) && optionalNumber('fatPer100', 100) && optionalNumber('servingG', 5000)
        && (!('lastUsedMs' in data()) || data().lastUsedMs is int)
        && stampedNow();
    }

    function validDevice() {
      return data().keys().hasOnly(['token', 'platform', 'locale', 'updatedAt'])
        && text(data().token, 1, 4096)
        && data().platform in ['android', 'ios']
        && text(data().locale, 2, 16)
        && stampedNow();
    }

    match /users/{uid} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid) && validProfile();

      match /workouts/{id} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && validWorkout(id);
      }

      match /routines/{id} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && validRoutine(id);
      }

      match /bodyWeights/{id} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && validBodyWeight(id);
      }

      match /customExercises/{id} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && validCustomExercise(id);
      }

      match /exercisePhotos/{id} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && validExercisePhoto(uid, id);
      }

      // The running workout: exactly one document, deleted when the workout ends.
      match /state/{doc} {
        allow read, delete: if owner(uid) && doc == 'active';
        allow create, update: if owner(uid) && doc == 'active' && validWorkout(data().id);
      }

      match /foodLog/{id} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && validFoodEntry(id);
      }

      match /foods/{id} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && validFood(id);
      }

      // One document per installation, for push messages.
      match /devices/{installId} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && validDevice();
      }
    }
  }
}
