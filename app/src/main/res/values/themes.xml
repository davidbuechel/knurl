<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window behind Compose; colours inside the app come from ui/theme. -->
    <style name="Theme.Knurl" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/steel_50</item>
    </style>

    <style name="Theme.Knurl.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_cobalt</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Knurl</item>
    </style>
</resources>
